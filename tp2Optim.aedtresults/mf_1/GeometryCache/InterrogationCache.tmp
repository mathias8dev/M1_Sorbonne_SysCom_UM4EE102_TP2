$begin 'InterrogationCache'
	Version=1
	$begin 'ValidationStatus'
		$begin 'Options'
			EntityCheckLevel='Strict'
			IgnoreUnclassifiedObjects=false
			SkipIntersectionChecks=false
		$end 'Options'
		Status=true
	$end 'ValidationStatus'
	$begin 'BodyCaches'
		$begin '6'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -25, -40, 0]
				High[3: 0, 40, 1.5800000000000001]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '6'
		$begin '34'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -25, -40, 1.5800000000000007]
				High[3: 0, 40, 16.580000000000002]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '34'
		$begin '62'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -1.5, -40, 1.5800000000000001]
				High[3: 0, 40, 1.6150000000000004]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '62'
		$begin '90'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -11.999999999999996, -40, -2.7755575615628914e-15]
				High[3: 0, -40, 12.639999999999999]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '90'
		$begin '102'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -11.999999999999996, 40, -2.7755575615628914e-15]
				High[3: 0, 40, 12.639999999999999]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '102'
	$end 'BodyCaches'
	$begin 'IntersectionCaches'
	$end 'IntersectionCaches'
$end 'InterrogationCache'
